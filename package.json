{
  "name": "datum",
  "private": true,
  "version": "0.1.0",
  "description": "A registry for parametric parts: source is the artifact, the build is the quality gate.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @datum/web",
    "dev:api": "npm run dev -w @datum/api",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "db:migrate": "npm run migrate -w @datum/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
