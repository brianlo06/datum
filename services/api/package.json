{
  "name": "@datum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx -e \"import('./src/db.js').then(async m => { console.log(await m.migrate()); process.exit(0); })\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@datum/scad-schema": "*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
